# Public canonical URL.
NEXT_PUBLIC_SITE_URL=https://flowcoat.com.au

# Media Studio
# In development, FLOWCOAT_MEDIA_DIR defaults to ~/.flowcoat-media.
# In production, set this to a persistent writable directory outside the app/deploy folder.
# FLOWCOAT_MEDIA_DIR=/var/lib/flowcoat-media
# FLOWCOAT_MEDIA_USERNAME=flowcoat
# FLOWCOAT_MEDIA_PASSWORD=replace-with-a-long-random-password

# Quote email backend (server-only; never expose with NEXT_PUBLIC_).
SMTP_HOST=mail-au.smtp2go.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USERNAME=noreply@flowcoat.com.au
SMTP_PASSWORD=replace-with-the-private-smtp-password
FLOWCOAT_FROM_EMAIL=noreply@flowcoat.com.au
FLOWCOAT_NOTIFICATION_EMAIL=sale@flowcoat.com.au
