# Set the public canonical URL in production.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional local-development media location. Defaults to ~/.flowcoat-media.
# FLOWCOAT_MEDIA_DIR=/absolute/path/to/flowcoat-media

# Required before enabling quote submission. Never expose service keys with NEXT_PUBLIC_.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# FLOWCOAT_NOTIFICATION_EMAIL=
